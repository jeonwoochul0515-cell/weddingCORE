rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 업체 가입 시 등록증 업로드 — 아직 agencyId 클레임이 없으므로
    // aid(= ag_${uid.slice(0,12)})의 접두어가 본인 uid와 일치하는지 검사.
    // 읽기도 같은 조건을 허용해야 한다. 가입 화면이 올린 직후 주소(getDownloadURL)를
    // 받는데, 그 시점에는 클레임이 없어 업체 권한만으로는 읽기가 막힌다.
    match /agencies/{aid}/registration/{file} {
      allow read: if request.auth != null
                  && (request.auth.token.agencyId == aid
                      || request.auth.token.role == 'admin'
                      || aid == 'ag_' + request.auth.uid[0:12]);
      allow write: if request.auth != null
                   && aid == 'ag_' + request.auth.uid[0:12]
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // 고객 서류. 경로는 documents/{문서id}/{파일명} 두 칸이지만, 예전 업로드가
    // documents/{파일명} 한 칸으로 남아 있을 수 있어 하위 경로 전체를 받는다.
    // 삭제는 따로 열어야 한다. write 규칙에 request.resource 조건이 있으면
    // 삭제 요청은 request.resource 가 없어 평가 자체가 실패한다.
    match /agencies/{aid}/clients/{cid}/documents/{allPaths=**} {
      allow read: if request.auth != null
                  && request.auth.token.agencyId == aid;
      allow create, update: if request.auth != null
                   && request.auth.token.agencyId == aid
                   && request.auth.token.role in ['owner', 'manager', 'staff']
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
      allow delete: if request.auth != null
                    && request.auth.token.agencyId == aid
                    && request.auth.token.role in ['owner', 'manager', 'staff'];
    }
  }
}
