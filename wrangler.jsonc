{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "weddingcore",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "weddingcore.net",
      "custom_domain": true
    },
    {
      "pattern": "www.weddingcore.net",
      "custom_domain": true
    }
  ],
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
    // 프리렌더된 /visa-simulator/index.html을 슬래시 없는 주소로 서빙한다.
    // sitemap·canonical·앱 내부 링크가 모두 슬래시 없는 형태라 리다이렉트를 없앤다.
    "html_handling": "drop-trailing-slash"
  }
}
