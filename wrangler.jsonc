{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "weddingcore",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "weddingcore.net",
      "custom_domain": true
    },
    {
      "pattern": "www.weddingcore.net",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
