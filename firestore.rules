rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() { return request.auth != null; }
    function myAgencyId() { return request.auth.token.agencyId; }
    function myRole() { return request.auth.token.role; }
    function isAdmin() { return isAuthed() && myRole() == 'admin'; }
    function isLawyer() { return isAuthed() && myRole() == 'lawyer'; }
    function isAgencyMember(aid) {
      return isAuthed() && myAgencyId() == aid
        && myRole() in ['owner', 'manager', 'staff', 'readonly'];
    }
    function canWriteAgency(aid) {
      return isAuthed() && myAgencyId() == aid
        && myRole() in ['owner', 'manager', 'staff'];
    }
    function isAgencyOwner(aid) {
      return isAuthed() && myAgencyId() == aid && myRole() == 'owner';
    }
    function isAgencyCreator(aid) {
      return isAuthed() && aid == 'ag_' + request.auth.uid[0:12];
    }

    match /regulations/{statuteId} {
      allow read: if isAuthed();
      allow write: if false;
      match /articles/{articleId} {
        allow read: if isAuthed();
        allow write: if false;
      }
    }
    match /regulatoryDelta/{id} {
      allow read: if isAuthed();
      allow write: if false;
    }
    match /obligationTemplates/{id} {
      allow read: if isAuthed();
      allow write: if isLawyer() || isAdmin();
    }
    match /visaRules/{year} {
      allow read: if true;
      allow write: if isLawyer() || isAdmin();
      match /rules/{id} {
        allow read: if true;
        allow write: if isLawyer() || isAdmin();
      }
    }
    match /legalTerms/{id} {
      allow read: if true;
      allow write: if isLawyer() || isAdmin();
    }

    match /users/{uid} {
      allow read: if isAuthed() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuthed()
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && request.resource.data.role == 'agency_owner'
                    && request.resource.data.agencyId == 'ag_' + uid[0:12]
                    && request.resource.data.lawyerId == null;
      allow update: if isAuthed()
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['displayName', 'lastLoginAt']);
      allow delete: if isAdmin();
    }
    match /lawyers/{lawyerId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    match /agencies/{aid} {
      allow read: if isAgencyMember(aid) || isAdmin()
                  || (isAuthed() && resource.data.ownerUid == request.auth.uid);
      allow create: if isAgencyCreator(aid)
                    && request.resource.data.agencyId == aid
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.verificationStatus == 'pending'
                    && request.resource.data.verifiedAt == null
                    && request.resource.data.subscription.plan == 'trial'
                    && request.resource.data.subscription.status == 'active';
      allow update: if isAgencyOwner(aid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'name', 'businessNumber', 'registrationNumber',
                      'registrationCertUrl', 'phone', 'address', 'ownerName',
                      'settings', 'updatedAt'
                    ]);
      allow delete: if isAdmin();
    }

    match /agencies/{aid}/members/{uid} {
      allow read: if isAgencyMember(aid) || (isAuthed() && request.auth.uid == uid);
      allow create: if canWriteAgency(aid)
                    || (isAuthed()
                        && request.auth.uid == uid
                        && aid == 'ag_' + uid[0:12]
                        && request.resource.data.uid == uid
                        && request.resource.data.role == 'owner');
      allow update, delete: if isAgencyOwner(aid);
    }

    // 직원 초대장. 문서 id는 소문자 이메일이다.
    // 대표는 전부 보고 만들고, 초대받은 본인은 자기 것만 본다(가입 뒤 확인용).
    // 상태를 accepted로 바꾸는 것은 서버 함수(claimStaffInvite)만 한다.
    match /agencies/{aid}/invites/{inviteId} {
      allow read: if isAgencyOwner(aid)
                  || (isAuthed() && request.auth.token.email == inviteId);
      allow create, delete: if isAgencyOwner(aid);
      allow update: if false;   // 수락 처리는 서버 함수만 한다
    }
    // 초대장을 이메일로 찾는 collectionGroup 조회는 서버(Admin SDK)만 쓴다.
    // 클라이언트에는 열지 않는다 — 열면 남의 업체 초대장을 훑을 수 있다.

    // 외국인 후보 명부. 고객에 매달리지 않는 업체 단위 명부다.
    match /agencies/{aid}/partners/{partnerId} {
      allow read: if isAgencyMember(aid);
      allow write: if canWriteAgency(aid);
    }

    match /agencies/{aid}/registrationDocuments/{documentId} {
      allow read: if isAgencyMember(aid) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // 마케팅 신청. 화면에서 넣는 것은 「상담 요청」이고, 카드 결제로 들어온 건은
    // 서버(confirmPayment)만 만든다.
    //
    // paid 계열 필드를 화면에서 못 쓰게 막는다. 이게 없으면 업체가 paid: true를
    // 붙여 신청을 넣고 돈을 낸 것처럼 위장할 수 있다. 담당자는 결제건을 먼저
    // 처리하므로, 돈을 안 내고 유료 작업을 받아가는 길이 된다.
    match /agencies/{aid}/marketingRequests/{requestId} {
      allow read: if isAgencyMember(aid) || isAdmin();
      allow create: if canWriteAgency(aid)
                    && request.resource.data.agencyId == aid
                    && request.resource.data.status == 'requested'
                    && !request.resource.data.keys()
                        .hasAny(['paid', 'paidAmount', 'orderId', 'billing']);
      // 업체는 결제 표시를 나중에 붙이지도 못한다.
      allow update: if (isAgencyOwner(aid)
                        && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['paid', 'paidAmount', 'orderId', 'billing', 'agencyId']))
                    || isAdmin();
      allow delete: if isAgencyOwner(aid) || isAdmin();
    }

    // 홈페이지 빠른 점검 위젯에서 들어온 상담 접수. 서버(Admin SDK)만 만들고,
    // 업체는 읽고 처리 상태·메모만 바꾼다. 손님 연락처를 화면에서 고칠 수 없게 한다.
    match /agencies/{aid}/leads/{leadId} {
      allow read: if isAgencyMember(aid) || isAdmin();
      allow update: if canWriteAgency(aid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['status', 'memo', 'updatedAt', 'contactedAt', 'nextActionAt',
                                'closedAt', 'closeReason', 'clientId', 'convertedAt']);
      allow create, delete: if isAdmin();
    }

    match /agencies/{aid}/visaCases/{caseId} {
      allow read: if isAgencyMember(aid) || isLawyer() || isAdmin();
      allow create: if canWriteAgency(aid)
                    && request.resource.data.agencyId == aid
                    && request.resource.data.stage == 'intake';
      allow update: if canWriteAgency(aid) || isLawyer() || isAdmin();
      allow delete: if isAgencyOwner(aid) || isAdmin();
    }

    match /agencies/{aid}/clients/{clientId} {
      allow read: if isAgencyMember(aid);
      allow create: if canWriteAgency(aid)
                    && request.resource.data.agencyId == aid
                    && !request.resource.data.keys().hasAny(['automationConsents']);
      allow update: if canWriteAgency(aid)
                    && request.resource.data.agencyId == aid
                    && !request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny(['agencyId', 'automationConsents']);
      allow delete: if isAgencyOwner(aid);
    }
    match /agencies/{aid}/clients/{clientId}/timeline/{itemId} {
      allow read: if isAgencyMember(aid);
      allow write: if canWriteAgency(aid);
    }
    // 대시보드는 고객을 가로질러 임박한 기한을 모아 보여준다(collectionGroup 쿼리).
    // 위의 경로 규칙은 collectionGroup 쿼리에 적용되지 않으므로 따로 선언해야 한다.
    // 없으면 화면이 permission-denied 로 조용히 멈춘 채 "불러오는 중"만 남는다.
    // 문서에 비정규화해 둔 agencyId 로 자기 업체 것만 열어 준다.
    match /{path=**}/timeline/{itemId} {
      allow read: if isAuthed()
                  && myRole() in ['owner', 'manager', 'staff', 'readonly']
                  && resource.data.agencyId == myAgencyId();
    }
    match /agencies/{aid}/clients/{clientId}/documents/{documentId} {
      allow read: if isAgencyMember(aid);
      allow write: if canWriteAgency(aid);
    }
    // 전화·문자·상담·방문 기록. 고객 문서와 같은 업체 권한을 적용한다.
    match /agencies/{aid}/clients/{clientId}/activities/{activityId} {
      allow read: if isAgencyMember(aid);
      allow create, update: if canWriteAgency(aid)
                            && request.resource.data.agencyId == aid
                            && request.resource.data.clientId == clientId;
      // 업무 이력은 실수로 지워 감사 흐름이 끊기지 않도록 화면에서 삭제하지 않는다.
      allow delete: if isAgencyOwner(aid) || isAdmin();
    }
    match /agencies/{aid}/clients/{clientId}/partners/{partnerId} {
      allow read: if isAgencyMember(aid);
      allow write: if canWriteAgency(aid);
    }
    match /agencies/{aid}/clients/{clientId}/backgroundInfo/{infoId} {
      allow read: if isAgencyMember(aid);
      allow write: if canWriteAgency(aid);
    }
    // 결제 주문. 금액과 상태는 서버(Admin SDK)만 쓴다.
    // 화면에서 금액을 고칠 수 있으면 결제 검증이 무의미해진다.
    match /agencies/{aid}/payments/{orderId} {
      allow read: if isAgencyMember(aid);
      allow write: if false;
    }

    // 업체 자체에 붙는 자료(통역자·현지 파트너·처분 이력·결격사유·사무소).
    // 고객과 무관하며 업체 구성원만 읽고 쓴다.
    match /agencies/{aid}/interpreters/{id} {
      allow read: if isAgencyMember(aid);
      allow write: if canWriteAgency(aid);
    }
    match /agencies/{aid}/localPartners/{id} {
      allow read: if isAgencyMember(aid);
      allow write: if canWriteAgency(aid);
    }
    match /agencies/{aid}/sanctions/{id} {
      allow read: if isAgencyMember(aid);
      allow write: if canWriteAgency(aid);
    }
    match /agencies/{aid}/disqualChecks/{id} {
      allow read: if isAgencyMember(aid);
      allow write: if canWriteAgency(aid);
    }
    match /agencies/{aid}/offices/{id} {
      allow read: if isAgencyMember(aid);
      allow write: if canWriteAgency(aid);
    }

    // 신상정보 제공 기록. 언제 누구에게 건넸는지가 처분을 가르는 지점이라
    // 업체 구성원만 읽고 쓰게 하되, 기록 자체는 남도록 삭제도 권한 안에서만 허용한다.
    match /agencies/{aid}/clients/{clientId}/backgroundInfo/{infoId}/deliveries/{deliveryId} {
      allow read: if isAgencyMember(aid);
      allow write: if canWriteAgency(aid);
    }
    match /agencies/{aid}/clients/{clientId}/backgroundInfo/{infoId}/translations/{lang} {
      allow read: if isAgencyMember(aid);
      allow create: if canWriteAgency(aid)
                    && (!request.resource.data.keys().hasAny(['signedAt', 'signedByName', 'signedByUid'])
                        || (request.resource.data.signedAt == null
                            && request.resource.data.signedByName == null));
      allow update: if canWriteAgency(aid)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny(['signedAt', 'signedByName', 'signedByUid']);
      allow delete: if isAgencyOwner(aid);
    }
    match /agencies/{aid}/matches/{matchId} {
      allow read: if isAgencyMember(aid);
      allow write: if canWriteAgency(aid);
    }

    // 약속. 맞선 밑이 아니라 업체 밑에 둔다 — 「이번 주 일정」을 한 번에 읽으려면
    // 모든 맞선을 뒤지지 않고 한 자리에서 가져올 수 있어야 한다.
    //
    // ★ 「확정」만은 화면에서 못 한다. 서버(confirmAppointment)만 바꿀 수 있다.
    //
    // 왜냐하면 확정은 「이 날 만납니다」를 업체가 선언하는 일이고, 그 앞에는
    // 신상정보 제공·양측 만남동의·통역 제공이 끝나 있어야 하기 때문이다(시행령 제3조지2,
    // 대법원 2018도7989). 화면에서 바로 고칠 수 있게 두면 버튼을 잠가도 콘솔로 뚫린다.
    // 잡는 것(planned)은 막지 않는다 — 막으면 기록을 안 남기고 만난다.
    match /agencies/{aid}/appointments/{appointmentId} {
      allow read: if isAgencyMember(aid);
      allow create: if canWriteAgency(aid)
                    && request.resource.data.status != 'confirmed';
      allow update: if canWriteAgency(aid)
                    && !(request.resource.data.status == 'confirmed'
                         && resource.data.status != 'confirmed');
      allow delete: if canWriteAgency(aid);
    }

    // 영상통화 기록. 서버(Admin SDK)만 만들고 고친다.
    //
    // 화면에서 쓰게 하면 안 되는 이유가 분명하다. 이 문서의 status·retentionUntil이
    // 파기 작업의 기준이고, contactLeaks는 「연락처를 주고받았다」는 증거다.
    // 업체가 고칠 수 있으면 불리한 기록을 지우고 통화를 되살릴 수 있다.
    match /agencies/{aid}/matches/{matchId}/calls/{callId} {
      allow read: if isAgencyMember(aid) || isAdmin();
      allow write: if false;
      // 전사본도 마찬가지다. 번호를 부른 줄만 지워지면 증거가 통째로 무의미해진다.
      match /transcript/{segmentId} {
        allow read: if isAgencyMember(aid) || isAdmin();
        allow write: if false;
      }
    }
    // 영상통화 입장 링크. 화면에서는 읽지도 쓰지도 못한다.
    //
    // 이 문서의 id가 곧 입장 코드다. 목록을 읽을 수 있으면 남의 업체 맞선 통화에
    // 그대로 들어갈 수 있다. 코드를 받은 사람은 joinVideoCall 함수를 거치고,
    // 그 함수만이 통화가 살아 있는지 보고 토큰을 만든다.
    match /callInvites/{code} {
      allow read, write: if false;
    }

    // 알림은 서버만 만든다. 구성원은 읽음 표시(readBy)만 바꿀 수 있다.
    // 이게 없으면 종의 빨간 점이 영영 안 꺼진다.
    match /agencies/{aid}/notifications/{notificationId} {
      allow read: if isAgencyMember(aid);
      allow update: if isAgencyMember(aid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      allow create, delete: if false;
    }
    // packId 목록은 상품 정본(functions/src/domain/pricing.ts CARAT_PACKS)과 같아야 한다.
    // 어긋나면 「계좌이체로 신청」이 항상 거부된다(2026-09-05 점검에서 발견).
    // 규칙 파일은 import가 안 돼 타입 검사가 못 잡는다. `npm run check:tracks`가 대조한다.
    match /agencies/{aid}/caratOrders/{orderId} {
      allow read: if isAgencyMember(aid) || isAdmin();
      allow create: if canWriteAgency(aid)
                    && request.resource.data.agencyId == aid
                    && request.resource.data.status == 'requested'
                    && request.resource.data.packId in ['pack_110', 'pack_330', 'pack_550'];
      allow update, delete: if isAdmin();
    }

    match /agencies/{aid}/automationJobs/{jobId} {
      allow read: if isAgencyMember(aid);
      allow write: if false;
    }

    match /legalReviews/{jobId} {
      allow read: if isLawyer() || isAdmin();
      allow write: if false;
    }

    // 공개 시뮬레이터 결과는 브라우저 안에서만 계산하며 서버에 저장하지 않는다.
    match /visaSimulations/{sessionId} {
      allow read, write: if false;
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 공개 엔드포인트 호출 빈도 기록. 서버(Admin SDK)만 다룬다.
    // 화면에 열면 세는 값을 지워 한도를 무력화할 수 있다.
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // 명시되지 않은 모든 경로는 기본 거부된다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
