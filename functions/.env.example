# ★ 어느 파일에 넣느냐가 갈린다.
#
#  - 코드에서 `secrets: [...]` 로 선언한 값(LIVEKIT_*, R2_*)은 **`.secret.local`** 에 넣는다.
#    `.env`에 두면 Firebase가 그걸 일반 환경변수로 같이 실어 보내고,
#    Secret Manager의 같은 이름과 부딪혀 배포가 통째로 죽는다.
#      Could not create Cloud Run service … Secret environment variable overlaps
#      non secret environment variable: LIVEKIT_URL
#    (2026-09-20 실제로 거기서 막혔다)
#  - 운영에는 `firebase functions:secrets:set <KEY>` 로 따로 올린다. 파일은 안 간다.
#  - 그 밖의 평범한 설정값만 `.env` 에 둔다.

# law.go.kr Open API OC(조회용 계정 ID)
# 발급: https://open.law.go.kr
LAW_GO_KR_OC=

# Anthropic Claude API 키
# 발급: https://console.anthropic.com
# W9-10 신상정보 번역에 사용
ANTHROPIC_API_KEY=

# 공공데이터포털 결혼중개업 공시 API 키 (Decoded)
# 발급: https://www.data.go.kr/data/15109765/openapi.do
# 업체 가입 자동완성 + 공시 인증 배지에 사용
DATA_GO_KR_KEY=

# LiveKit — 영상통화 (신랑·신부 후보 + 통역)
# 발급: https://cloud.livekit.io
#
# 세 값이 모두 있어야 통화가 열린다. 없으면 화면이 「아직 연결되지 않았습니다」로
# 안내하고 버튼을 잠그므로, 미설정 상태로 배포해도 다른 기능에 영향은 없다.
#
# ★ 단, firebase는 defineSecret/secrets에 적힌 시크릿이 Secret Manager에 없으면
#   배포 자체를 막는다. 아직 계정이 없으면 자리표시 값으로 먼저 만들어 둔다
#   (payments의 TOSS_SECRET_KEY와 같은 방식):
#     printf 'NOT_CONFIGURED' | gcloud secrets create LIVEKIT_API_SECRET --data-file=-
# → `.secret.local`
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# wss://으로 시작하는 방 서버 주소
LIVEKIT_URL=

# 통화 녹화본을 둘 곳 (Cloudflare R2). → `.secret.local`
# 없으면 통화는 열리되 녹화가 안 된다. 그 사실은 화면이 미리 알린다.
# 버킷에는 1년 뒤 자동 삭제하는 수명주기 규칙을 걸어 둔다 — 영상 보관은 1년이다.
#
# 버킷 생성부터 규칙·키 확인까지 한 번에 하려면:
#   node scripts/setupR2Recording.mjs --bucket … --access-key … --secret … --cf-token …
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
