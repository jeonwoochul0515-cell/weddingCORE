# law.go.kr Open API OC(조회용 계정 ID)
# 발급: https://open.law.go.kr
LAW_GO_KR_OC=

# Anthropic Claude API 키
# 발급: https://console.anthropic.com
# W9-10 신상정보 번역에 사용
ANTHROPIC_API_KEY=

# 공공데이터포털 결혼중개업 공시 API 키 (Decoded)
# 발급: https://www.data.go.kr/data/15109765/openapi.do
# 업체 가입 자동완성 + 공시 인증 배지에 사용
DATA_GO_KR_KEY=

# LiveKit — 영상통화 (신랑·신부 후보 + 통역)
# 발급: https://cloud.livekit.io
#
# 세 값이 모두 있어야 통화가 열린다. 없으면 화면이 「아직 연결되지 않았습니다」로
# 안내하고 버튼을 잠그므로, 미설정 상태로 배포해도 다른 기능에 영향은 없다.
#
# ★ 단, firebase는 defineSecret/secrets에 적힌 시크릿이 Secret Manager에 없으면
#   배포 자체를 막는다. 아직 계정이 없으면 자리표시 값으로 먼저 만들어 둔다
#   (payments의 TOSS_SECRET_KEY와 같은 방식):
#     printf 'NOT_CONFIGURED' | gcloud secrets create LIVEKIT_API_SECRET --data-file=-
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# wss://으로 시작하는 방 서버 주소
LIVEKIT_URL=
